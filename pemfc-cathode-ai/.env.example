# Copy this file to .env and fill in your keys. .env is gitignored: never commit it.
# The requested names:
OPEN_AI_KEY=
OPEN_AI_MODEL=GPT-6-LUNA
# The official OpenAI name is also accepted (the template uses it):
# OPENAI_API_KEY=
# Optional
OPEN_AI_EMBED_MODEL=text-embedding-3-small
# Set the prices (USD per 1M tokens) to see dollars per question; they are not assumed for any model
OPEN_AI_PRICE_IN_PER_1M=
OPEN_AI_PRICE_OUT_PER_1M=
CROSSREF_MAILTO=

# Optional Pinecone vector store (Local retrieval is the default; Pinecone is opt-in)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=pemfc-cathode-ai
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# PINECONE_EMBED_MODEL=llama-text-embed-v2
